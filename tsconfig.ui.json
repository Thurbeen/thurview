{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/ui/**/*.ts",
    "src/document/*.ts",
    "src/store.ts",
    "src/diff.ts",
    "src/git.ts",
    "src/symbols.ts",
    "src/highlight.ts"
  ]
}
