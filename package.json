{
  "name": "thurview",
  "version": "0.1.0",
  "description": "Review an opened GitHub PR or GitLab MR from your coding agent: one summary edited in place, one thread per finding, followed until merge.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "thurview": "bin/thurview.js"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "pnpm typecheck && pnpm fmt:check",
    "test": "vitest run",
    "check": "pnpm lint && pnpm test",
    "dev": "tsx src/main.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@toon-format/toon": "2.3.1",
    "axi-sdk-js": "0.1.11",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@11.24.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thurbeen/thurview.git"
  },
  "homepage": "https://github.com/Thurbeen/thurview",
  "keywords": [
    "code-review",
    "pull-request",
    "merge-request",
    "agent",
    "skill",
    "axi",
    "cli",
    "review",
    "claude-code",
    "agent-skills"
  ],
  "publishConfig": {
    "access": "public"
  }
}
